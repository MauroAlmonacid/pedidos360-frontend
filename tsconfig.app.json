/* Configuración de TypeScript específica para la aplicación cliente de Angular */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Lista de tipos globales requeridos (vacío por defecto en aplicaciones limpias)
    "types": []
  },
  "include": [
    // Le indica al compilador qué archivos fuente de TypeScript debe procesar
    "src/**/*.ts"
  ],
  "exclude": [
    // Ignora los archivos de pruebas unitarias durante la compilación regular
    "src/**/*.spec.ts"
  ]
}