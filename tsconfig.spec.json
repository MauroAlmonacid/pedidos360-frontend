/* Configuración de TypeScript para la ejecución de pruebas unitarias */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Le define a TypeScript la carpeta exacta de origen para que no intente adivinarla
    "rootDir": "./src/app",
    // Tipos requeridos exclusivamente para el framework de pruebas
    "types": [
      "jasmine"
    ]
  },
  "include": [
    // Apunta directamente a los archivos de prueba que viven dentro de app
    "src/app/**/*.spec.ts",
    "src/app/**/*.d.ts"
  ]
}